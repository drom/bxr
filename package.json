{
  "name": "bxr",
  "version": "0.3.0",
  "description": "Box layout engine",
  "author": "Aliaksei Chapyzhenka",
  "license": "MIT",
  "homepage": "https://github.com/drom/bxr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drom/bxr.git"
  },
  "bugs": {
    "url": "https://github.com/drom/bxr/issues"
  },
  "main": "lib",
  "files": [
    "build/bxr.js",
    "lib"
  ],
  "unpkg": "build/bxr.js",
  "scripts": {
    "test": "eslint lib test && nyc -r=lcov -r=text mocha test",
    "unpkg": "browserify --standalone bxr lib/index.js > build/bxr.js",
    "prepare": "npm run test && mkdir -p build && npm run unpkg",
    "docs:preview": "notebooks preview --root notebooks",
    "docs:build": "notebooks build --out ../docs --root notebooks -- notebooks/*.html"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "onml": "^2.1.0"
  },
  "devDependencies": {
    "@drom/eslint-config": "^0.13.0",
    "@observablehq/notebook-kit": "^1.0.1",
    "browserify": "^17.0.0",
    "chai": "^5.2.1",
    "eslint": "^8.57.1",
    "mocha": "^11.7.1",
    "nyc": "^17.1.0",
    "watchify": "^4.0.0"
  },
  "eslintConfig": {
    "extends": "@drom/eslint-config/eslint8/node22"
  }
}
